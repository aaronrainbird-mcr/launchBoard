# Copy to .env.local (git-ignored). Leave everything unset to run on this computer only.

# Hosted mode: the team key people enter once at /join.
# BOARD_TEAM_KEY=

# One personal key per person for their AI assistant: Name:key,Name:key (keys 16+ characters).
# BOARD_AGENT_KEYS=Aaron:...,Colin:...

# The team, comma separated. Defaults to Aaron,Abdulmuiz,Colin,Nick,Skye.
# BOARD_PEOPLE=

# The board's own address, used in redirects and the agent guide.
# BOARD_PUBLIC_URL=https://launch-board.example

# Supabase storage (server only; never NEXT_PUBLIC_). Without these, data goes to .local-data/board.json.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# BOARD_STORAGE=supabase   # "file" forces the local file even when Supabase is set

# Where the local file lives. Defaults to ./.local-data
# BOARD_DATA_DIR=
